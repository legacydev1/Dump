# ============================================================
#  LOGSBOTv3 — Environment Configuration
#  Copy this file to .env and fill in your values
# ============================================================

# ── Core ─────────────────────────────────────────────────────
BOT_TOKEN=7123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Root admin Telegram user IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# ── Telegram MTProto API (for large file support >20MB) ──────
API_ID=
API_HASH=
TELETHON_SESSION=data/telethon_session

# ── Force-Subscribe ──────────────────────────────────────────
# Channel / group usernames or numeric IDs (comma-separated)
REQUIRED_CHANNELS=@mychannel1,@mychannel2
REQUIRED_GROUPS=

# ── Database ─────────────────────────────────────────────────
DATABASE_PATH=data/bot.db

# ── File Handling ────────────────────────────────────────────
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_MB=200

# ── Plans ────────────────────────────────────────────────────
DEFAULT_PLAN_ID=1

# ── Payment ──────────────────────────────────────────────────
PAYMENT_INSTRUCTIONS="Contact admin to complete payment."
SUPPORT_CONTACT=@youradmin

# ── Search Limits ────────────────────────────────────────────
FREE_RESULT_LIMIT=50
PREMIUM_PLAN_IDS=2,3,4

# ── Search Response Video ────────────────────────────────────
# Telegram file_id of a video to send with every search result.
# Get the file_id by sending a video to your bot and checking logs.
# Leave empty to disable video responses.
SEARCH_RESULT_VIDEO=

# ── Bot Behaviour ────────────────────────────────────────────
RESULTS_PER_PAGE=10
INGESTION_CHUNK_SIZE=500

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
